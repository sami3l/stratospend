# Local development only. Copy this file to .env (which is gitignored):
#   cp .env.example .env
# The values match the defaults in compose.yaml and backend/src/main/resources/application.yml.
# Never put real passwords, cloud credentials or tokens in this file.

# PostgreSQL container, read by Docker Compose.
POSTGRES_DB=cloudcost
POSTGRES_USER=cloudcost
POSTGRES_PASSWORD=cloudcost-local

# Backend. Spring Boot does not read this file: if you change the values above,
# set these in your shell or in the IDE run configuration.
# DB_URL=jdbc:postgresql://localhost:5433/cloudcost
# DB_USERNAME=cloudcost
# DB_PASSWORD=cloudcost-local
# SERVER_PORT=8080
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend. Next.js reads frontend/.env.local, not this file.
# The API URL defaults to http://localhost:8080.
# NEXT_PUBLIC_API_URL=http://localhost:8080
